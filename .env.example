# Copy this file to .env and adjust values if needed.

# Enables debug mode (detailed errors). Never enable in production.
DEBUG=false

# Database connection string. SQLite by default; for PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/finance
DATABASE_URL=sqlite:///data/finance.db

# Exchange rates: timeout of one request to an online source (NBRB, CBR, currency-api).
RATE_REQUEST_TIMEOUT_SECONDS=5
# If no source is reachable, a rate from the system's own history may be suggested
# when it is at most this many days away from the operation date.
RATE_HISTORY_MAX_DAYS=7
